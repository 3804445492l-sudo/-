local function toggle_ui(b)
	if b then
		old_m_b = U.MouseBehavior
		old_m_v = U.MouseIconEnabled
		gui.Enabled = true
		unlock.Modal = false
		R:BindToRenderStep("GX_M", 2000, function()
			U.MouseIconEnabled = true
			if U:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
				U.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			else
				U.MouseBehavior = Enum.MouseBehavior.Default
			end
		end)
	else
		R:UnbindFromRenderStep("GX_M")
		gui.Enabled = false
		unlock.Modal = false
		U.MouseBehavior = old_m_b
		U.MouseIconEnabled = old_m_v
	end
end

local function ghost()
	st.ghost = not st.ghost
	local c, r, h = get_char()
	if st.ghost then
		if r then
			r.Anchored = true
		end
		local p = cam.CFrame.Position
		local rx, ry = 0, 0
		cam.CameraType = Enum.CameraType.Scriptable
		R:BindToRenderStep("GX_G", 201, function()
			local d = U:GetMouseDelta()
			ry = ry - d.X * 0.4
			rx = math.clamp(rx - d.Y * 0.4, -85, 85)
			local cr = CFrame.fromEulerAnglesYXZ(math.rad(rx), math.rad(ry), 0)
			local dir = Vector3.zero
			if U:IsKeyDown(Enum.KeyCode.W) then
				dir += cr.LookVector
			end
			if U:IsKeyDown(Enum.KeyCode.S) then
				dir -= cr.LookVector
			end
			if U:IsKeyDown(Enum.KeyCode.A) then
				dir -= cr.RightVector
			end
			if U:IsKeyDown(Enum.KeyCode.D) then
				dir += cr.RightVector
			end
			if U:IsKeyDown(Enum.KeyCode.E) then
				dir += Vector3.new(0, 1, 0)
			end
			if U:IsKeyDown(Enum.KeyCode.Q) then
				dir -= Vector3.new(0, 1, 0)
			end
			p = p + dir * (U:IsKeyDown(Enum.KeyCode.LeftShift) and 3 or 1)
			cam.CFrame = CFrame.new(p) * cr
			U.MouseBehavior = Enum.MouseBehavior.LockCenter
		end)
	else
		R:UnbindFromRenderStep("GX_G")
		cam.CameraType = Enum.CameraType.Custom
		task.wait()
		local _, _, h2 = get_char()
		if h2 then
			cam.CameraSubject = h2
		end
		if r then
			r.Anchored = false
		end
		U.MouseBehavior = Enum.MouseBehavior.Default
		U.MouseIconEnabled = true
	end
end

