function fling(dur)
	if fling_conn then
		fling_conn:Disconnect()
	end
	local t = P:FindFirstChild(st.f_t)
	if not t or not t.Character then
		return
	end
	local _, r, h = get_char()
	if not r or not h then
		return
	end
	local old = r.CFrame
	st.f_a = true
	h.PlatformStand = true
	fling_conn = R.Heartbeat:Connect(function()
		if not st.f_a or not t or not t.Character or not t.Character:FindFirstChild("HumanoidRootPart") then
			st.f_a = false
			if fling_conn then
				fling_conn:Disconnect()
			end
			return
		end
		local tr = t.Character.HumanoidRootPart
		r.CFrame = tr.CFrame * CFrame.new(math.sin(tick() * 80) * 2, 0, math.cos(tick() * 80) * 2)
		r.AssemblyLinearVelocity = Vector3.new(0, st.f_p, 0)
		r.AssemblyAngularVelocity = Vector3.new(5000, 5000, 5000)
	end)
	task.wait(dur)
	st.f_a = false
	if fling_conn then
		fling_conn:Disconnect()
	end
	local _, r2, h2 = get_char()
	if r2 then
		r2.CFrame = old
		r2.AssemblyLinearVelocity = Vector3.zero
	end
	if h2 then
		h2.PlatformStand = false
	end
end

R.Heartbeat:Connect(function(dt)
	local char, root, hum = get_char()
	if not char or not root then
		if active_vf then
			active_vf:Destroy()
			active_vf = nil
		end
		return
	end

	if not st.ghost and st.sp and hum.MoveDirection.Magnitude > 0 then
		root.CFrame += (hum.MoveDirection * st.sp_v * dt)
	end

	if not st.ghost and st.sp_phys and hum.MoveDirection.Magnitude > 0 then
		if not active_vf or active_vf.Parent ~= root then
			if active_vf then
				active_vf:Destroy()
			end
			if active_att then
				active_att:Destroy()
			end
			active_att = Instance.new("Attachment", root)
			active_vf = Instance.new("VectorForce", root)
			active_vf.Attachment0 = active_att
			active_vf.RelativeTo = Enum.ActuatorRelativeTo.World
		end
		active_vf.Force = hum.MoveDirection * (st.sp_v * 10000)
	else
		if active_vf then
			active_vf:Destroy()
			active_vf = nil
		end
		if active_att then
			active_att:Destroy()
			active_att = nil
		end
	end

	if st.clip then
		for _, v in pairs(char:GetDescendants()) do
			if v:IsA("BasePart") and v.CanCollide then
				v.CanCollide = false
			end
		end
	end
	if st.fov_l then
		cam.FieldOfView = st.fov_v
	end
	if st.fog then
		L.FogEnd = 9e9
		L.FogStart = 0
	end
	if st.fb then
		L.Brightness = 2
		L.GlobalShadows = false
		L.OutdoorAmbient = Color3.new(1, 1, 1)
	end
	if st.esp then
		local col = Color3.fromHSV(tick() % 3 / 3, 1, 1)
		for _, p in pairs(P:GetPlayers()) do
			if p ~= lp and p.Character then
				local h = p.Character:FindFirstChild("FGH") or Instance.new("Highlight", p.Character)
				h.Name = "FGH"
				h.FillColor = col
			end
		end
	end
	if st.aim and U:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local target, d = nil, st.aim_f
		for _, p in pairs(P:GetPlayers()) do
			if p ~= lp and p.Character and (not st.ex_e or not table.find(st.ex_l, p.Name)) then
				local pt = p.Character:FindFirstChild(st.aim_p)
				if pt and (pt.Position - root.Position).Magnitude < st.aim_d then
					local pos, s = cam:WorldToViewportPoint(pt.Position)
					local m = (Vector2.new(pos.X, pos.Y) - Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)).Magnitude
					if s and m < d then
						d = m
						target = pt
					end
				end
			end
		end
		if target then
			cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, target.Position), 1 / st.aim_s)
		end
	end
end)

