U.InputBegan:Connect(function(io, g)
	if not g then
		if io.KeyCode == st.m_k then
			toggle_ui(not gui.Enabled)
		elseif io.KeyCode == Enum.KeyCode.B and st.ft_b then
			local _, r = get_char()
			if r then
				st.ft_m = r.CFrame
			end
		elseif io.KeyCode == Enum.KeyCode.N and st.ft_b then
			local _, r = get_char()
			if r and st.ft_m then
				local cur = r.CFrame
				r.CFrame = st.ft_m
				st.ft_m = cur
			end
		elseif io.KeyCode == Enum.KeyCode.M and st.fc_b then
			ghost()
		end
	end
end)
